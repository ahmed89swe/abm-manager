rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function currentUserDoc() {
      return get(userDocPath(request.auth.uid));
    }

    function isActiveUser() {
      return hasProfile() &&
        (!('isActive' in currentUserDoc().data) ||
          currentUserDoc().data.isActive == true);
    }

    function isManager() {
      return isActiveUser() && currentUserDoc().data.role == 'manager';
    }

    function isDelegate() {
      return isActiveUser() && currentUserDoc().data.role == 'delegate';
    }

    function currentManagerId() {
      return !hasProfile()
        ? ''
        : (isManager()
            ? (('managerId' in currentUserDoc().data &&
                currentUserDoc().data.managerId is string &&
                currentUserDoc().data.managerId != '')
                ? currentUserDoc().data.managerId
                : request.auth.uid)
            : (('managerId' in currentUserDoc().data &&
                currentUserDoc().data.managerId is string)
                ? currentUserDoc().data.managerId
                : ''));
    }

    function legacyPrimaryManagerUid() {
      return exists(/databases/$(database)/documents/app_config/bootstrap)
        ? get(/databases/$(database)/documents/app_config/bootstrap).data.managerUid
        : '';
    }

    function isLegacyMigrationActive() {
      return isManager() &&
        request.auth.uid == legacyPrimaryManagerUid() &&
        (!('legacyMigrated' in currentUserDoc().data) ||
          currentUserDoc().data.legacyMigrated != true);
    }

    function delegateAudienceTags() {
      return [
        'USER_' + request.auth.uid,
        (('governorateId' in currentUserDoc().data &&
          currentUserDoc().data.governorateId is string)
            ? ('GOV_' + currentUserDoc().data.governorateId)
            : 'GOV___NONE__'),
        'DELEGATES_' + currentManagerId(),
        'ALL_' + currentManagerId()
      ];
    }

    // إعداد التهيئة الأولي وبيانات الإصدارات
    match /app_config/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.managerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /app_config/version_info {
      allow read: if true;
      allow create, update: if isManager();
      allow delete: if false;
    }

    // المستخدمون (المدراء المستقلون + المندوبون المعزولون لكل مدير)
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId()))
      );

      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId());

      allow create: if
        (isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'manager' &&
          (!('managerId' in request.resource.data) ||
            request.resource.data.managerId == request.auth.uid)) ||
        (isManager() &&
          request.resource.data.role == 'delegate' &&
          request.resource.data.managerId == currentManagerId());

      allow update: if
        isLegacyMigrationActive() ||
        (isManager() && (
          (request.auth.uid == userId &&
            (!('managerId' in request.resource.data) ||
              request.resource.data.managerId == currentManagerId())) ||
          (resource.data.managerId == currentManagerId() &&
            resource.data.role == 'delegate' &&
            request.resource.data.managerId == currentManagerId())
        )) ||
        (isActiveUser() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'photoUrl', 'avatarBase64', 'fcmTokens'])) ||
        (isSignedIn() &&
          request.auth.uid == userId &&
          (!('managerId' in resource.data) || resource.data.managerId == '') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['managerId']) &&
          request.resource.data.managerId == legacyPrimaryManagerUid()) ||
        (isDelegate() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['virtualBoxBalance']) &&
          request.resource.data.virtualBoxBalance is number);

      allow delete: if false;
    }

    // المحافظات والمواد (معزولة لكل مدير)
    match /governorates/{docId} {
      allow get: if isLegacyMigrationActive() ||
        (isActiveUser() &&
          (resource == null || resource.data.managerId == currentManagerId()));
      allow list: if isLegacyMigrationActive() ||
        (isActiveUser() && resource.data.managerId == currentManagerId());
      allow create: if isManager() &&
        request.resource.data.managerId == currentManagerId();
      allow update: if isLegacyMigrationActive() ||
        (isManager() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId());
      allow delete: if isManager() &&
        resource.data.managerId == currentManagerId();
    }

    match /materials/{docId} {
      allow get: if isLegacyMigrationActive() ||
        (isActiveUser() &&
          (resource == null || resource.data.managerId == currentManagerId()));
      allow list: if isLegacyMigrationActive() ||
        (isActiveUser() && resource.data.managerId == currentManagerId());
      allow create: if isManager() &&
        request.resource.data.managerId == currentManagerId();
      allow update: if isLegacyMigrationActive() ||
        (isManager() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId());
      allow delete: if isManager() &&
        resource.data.managerId == currentManagerId();
    }

    // الصناديق الشهرية العامة للمدير فقط (سرية تامة ومعزولة لكل مدير)
    match /manager_monthly_boxes/{monthId} {
      allow get: if isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId()));
      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId());
      allow create: if
        (isManager() && (
          request.resource.data.managerId == currentManagerId() ||
          isLegacyMigrationActive()
        )) ||
        (isDelegate() &&
          request.resource.data.managerId == currentManagerId() &&
          request.resource.data.keys().hasOnly([
            'managerId', 'monthKey', 'year', 'month',
            'totalCompanyTopUps', 'totalInvoiceDeductions',
            'totalExpenseDeductions', 'currentBalance', 'updatedAt'
          ]));
      allow update: if
        isLegacyMigrationActive() ||
        (isManager() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId()) ||
        (isDelegate() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId() &&
          request.resource.data.keys().hasOnly([
            'managerId', 'monthKey', 'year', 'month',
            'totalCompanyTopUps', 'totalInvoiceDeductions',
            'totalExpenseDeductions', 'currentBalance', 'updatedAt'
          ]));
      allow delete: if isLegacyMigrationActive();
    }

    // الصناديق الشهرية الفرعية للمحافظات (للمدير فقط ومعزولة لكل مدير)
    match /governorate_monthly_boxes/{govMonthId} {
      allow get: if isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId()));
      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId());
      allow create: if
        (isManager() && (
          request.resource.data.managerId == currentManagerId() ||
          isLegacyMigrationActive()
        )) ||
        (isDelegate() &&
          request.resource.data.managerId == currentManagerId() &&
          request.resource.data.governorateId == currentUserDoc().data.governorateId &&
          request.resource.data.keys().hasOnly([
            'managerId', 'governorateId', 'governorateName', 'monthKey',
            'year', 'month', 'totalTopUps', 'totalInvoiceDeductions',
            'totalExpenseDeductions', 'currentBalance', 'updatedAt'
          ]));
      allow update: if
        isLegacyMigrationActive() ||
        (isManager() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId()) ||
        (isDelegate() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId() &&
          request.resource.data.governorateId == currentUserDoc().data.governorateId &&
          request.resource.data.keys().hasOnly([
            'managerId', 'governorateId', 'governorateName', 'monthKey',
            'year', 'month', 'totalTopUps', 'totalInvoiceDeductions',
            'totalExpenseDeductions', 'currentBalance', 'updatedAt'
          ]));
      allow delete: if isLegacyMigrationActive();
    }

    // حركات الصناديق المالية (للمدير فقط ومعزولة + السماح بتعديل التعبئة من الشركة)
    match /box_transactions/{txId} {
      allow get: if isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId()));
      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId());
      allow create: if isActiveUser() &&
        request.resource.data.managerId == currentManagerId() &&
        request.resource.data.performedByUid == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if isLegacyMigrationActive() ||
        (isManager() &&
          resource.data.managerId == currentManagerId() &&
          resource.data.type == 'company_topup' &&
          request.resource.data.type == 'company_topup' &&
          request.resource.data.managerId == currentManagerId() &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['monthKey', 'amount', 'notes', 'editedByUid', 'editedByName', 'updatedAt']));
      allow delete: if false;
    }

    // الفواتير (معزولة بالكامل لكل مدير وفريقه)
    match /invoices/{invoiceId} {
      allow get: if isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId())) ||
        (isDelegate() &&
          (resource == null || (
            resource.data.managerId == currentManagerId() &&
            (resource.data.createdByUid == request.auth.uid ||
              (resource.data.governorateId == currentUserDoc().data.governorateId &&
                (resource.data.assignmentType == 'all_gov_delegates' ||
                  resource.data.assignedDelegateId == request.auth.uid))))));

      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId()) ||
        (isDelegate() &&
          resource.data.managerId == currentManagerId() &&
          (resource.data.createdByUid == request.auth.uid ||
            (resource.data.governorateId == currentUserDoc().data.governorateId &&
              (resource.data.assignmentType == 'all_gov_delegates' ||
                resource.data.assignedDelegateId == request.auth.uid))));

      allow create: if isActiveUser() &&
        request.resource.data.managerId == currentManagerId() &&
        request.resource.data.createdByUid == request.auth.uid;

      allow update: if
        isLegacyMigrationActive() ||
        (isManager() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId()) ||
        (isDelegate() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.managerId == currentManagerId() &&
          resource.data.status == 'unpaid' &&
          request.resource.data.status == 'paid' &&
          request.resource.data.paidByUid == request.auth.uid &&
          request.resource.data.paidByRole == 'delegate' &&
          request.resource.data.paidFromSource == 'delegate_box' &&
          (resource.data.createdByUid == request.auth.uid ||
            (resource.data.governorateId == currentUserDoc().data.governorateId &&
              (resource.data.assignmentType == 'all_gov_delegates' ||
                resource.data.assignedDelegateId == request.auth.uid))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items', 'totalAmount', 'isPricePending', 'status',
            'paidAt', 'paidByUid', 'paidByName', 'paidByRole',
            'paidFromSource', 'deductedManagerMonthKey',
            'receiptImageUrl', 'updatedAt'
          ]));

      allow delete: if false;
    }

    // المصاريف الشخصية (معزولة لكل مدير وفريقه)
    match /personal_expenses/{expenseId} {
      allow get: if isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId())) ||
        (isDelegate() &&
          (resource == null || (
            resource.data.managerId == currentManagerId() &&
            resource.data.userId == request.auth.uid)));
      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId()) ||
        (isDelegate() &&
          resource.data.managerId == currentManagerId() &&
          resource.data.userId == request.auth.uid);
      allow create: if isActiveUser() &&
        request.resource.data.managerId == currentManagerId() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if isLegacyMigrationActive();
      allow delete: if false;
    }

    // سجل العمليات (معزول لكل مدير وفريقه)
    match /audit_logs/{logId} {
      allow get: if isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId())) ||
        (isDelegate() &&
          (resource == null || (
            resource.data.managerId == currentManagerId() &&
            resource.data.actorUid == request.auth.uid)));
      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId()) ||
        (isDelegate() &&
          resource.data.managerId == currentManagerId() &&
          resource.data.actorUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        (!('managerId' in request.resource.data) ||
          request.resource.data.managerId == currentManagerId() ||
          (request.resource.data.actionType in ['manager_bootstrap', 'manager_setup'] &&
            request.resource.data.managerId == request.auth.uid));
      allow update: if isLegacyMigrationActive();
      allow delete: if false;
    }

    // الإشعارات السحابية (معزولة لكل مدير وفريقه)
    match /notifications/{notifId} {
      allow get: if isLegacyMigrationActive() ||
        (isManager() &&
          (resource == null || resource.data.managerId == currentManagerId())) ||
        (isDelegate() &&
          (resource == null || (
            resource.data.managerId == currentManagerId() &&
            resource.data.audienceTags.hasAny(delegateAudienceTags()))));
      allow list: if isLegacyMigrationActive() ||
        (isManager() && resource.data.managerId == currentManagerId()) ||
        (isDelegate() &&
          resource.data.managerId == currentManagerId() &&
          resource.data.audienceTags.hasAny(delegateAudienceTags()));
      allow create: if isActiveUser() &&
        request.resource.data.managerId == currentManagerId() &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if
        isLegacyMigrationActive() ||
        (isActiveUser() &&
          resource.data.managerId == currentManagerId() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readByUids']) &&
          request.resource.data.readByUids.hasAll(resource.data.readByUids));
      allow delete: if false;
    }
  }
}
